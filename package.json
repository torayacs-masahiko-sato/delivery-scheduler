{
  "name": "delivery-scheduler",
  "version": "1.0.0",
  "scripts": {
    "install:all": "npm install && cd client && npm install",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "dev": "concurrently \"node server/index.js\" \"cd client && npm run dev\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "googleapis": "^140.0.1",
    "nodemailer": "^10.2.0",
    "pg": "^8.11.5",
    "qrcode": "^1.5.4",
    "resend": "^3.2.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
